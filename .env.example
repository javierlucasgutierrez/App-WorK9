# Base de datos. Ahora: un archivo SQLite local.
# Para PostgreSQL en el futuro: cambia provider en prisma/schema.prisma a "postgresql"
# y pon aquí algo como: postgresql://usuario:clave@servidor:5432/mercak9
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar las sesiones. Cámbiala por una cadena larga y aleatoria.
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-secreta"

# Dónde se guardan las fotos: "local" (carpeta uploads/). Más adelante: "s3", etc.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"

# Dirección pública de la web (para los enlaces de los correos y al compartir anuncios).
APP_URL="http://localhost:3000"

# Envío de correos: "console" (no se envían de verdad: se guardan en la carpeta correos/ y se ven
# en http://localhost:3000/correos) o "resend" (servicio real, https://resend.com).
MAIL_DRIVER="console"
MAIL_FROM="MercaK9 <hola@mercak9.es>"
RESEND_API_KEY=""

# Correos de los administradores (separados por comas): pueden revisar denuncias en /admin.
ADMIN_EMAILS="laura@demo.com"

# Entrar con Google (opcional). Si están vacíos, no aparece el botón.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
