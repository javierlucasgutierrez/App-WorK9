# Base de datos. Ahora: un archivo SQLite local.
# Para PostgreSQL en el futuro: cambia provider en prisma/schema.prisma a "postgresql"
# y pon aquí algo como: postgresql://usuario:clave@servidor:5432/mercak9
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar las sesiones. Cámbiala por una cadena larga y aleatoria.
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-secreta"

# Dónde se guardan las fotos: "local" (carpeta uploads/). Más adelante: "s3", etc.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
