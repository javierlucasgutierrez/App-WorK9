// Esquema de la base de datos de MercaK9.
//
// Ahora usa SQLite (un archivo local). Para pasar a PostgreSQL:
//   1. Cambia provider = "sqlite" por provider = "postgresql".
//   2. Cambia DATABASE_URL en .env.
//   3. Borra la carpeta prisma/migrations y ejecuta: npx prisma migrate dev --name inicio
// Por eso aquí no se usa nada exclusivo de SQLite: los "tipos" (estado, categoría...)
// se guardan como texto y sus valores permitidos están en src/lib/constants.ts.
//
// Preparado para crecer (sin tocar lo que ya hay, solo añadiendo tablas):
//   - Pagos: los precios van en céntimos (priceCents); se añadiría una tabla Order/Payment.
//   - Chat: cada ListingInterest es el inicio de una conversación; se añadiría Message.
//   - Avisos: ya se manda un correo al anunciante con cada «Me interesa»; para avisos dentro de
//     la web se añadiría Notification (userId, tipo, leído).
//   - Zona de adiestradores: se añadirían Dog, Assignment, TrainingSession... enlazadas a User
//     (el código de la primera versión está en la rama claude/dog-training-platform-vnggro).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Socio del club.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String? // vacío si solo entra con Google
  googleId     String?   @unique
  name         String
  phone        String?
  location     String? // zona o ciudad
  accountType  String    @default("INDIVIDUAL") // ver ACCOUNT_TYPES en src/lib/constants.ts
  role         String    @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime  @default(now())
  emailVerifiedAt DateTime?
  blockedAt    DateTime? // bloqueado por moderación: no puede entrar y sus anuncios no se ven

  // Escaparate (sobre todo para profesionales, creadores y talleres)
  bio       String?
  website   String?
  instagram String?
  avatarKey String? // logo o foto (ver src/lib/storage.ts)

  listings  Listing[]
  interests ListingInterest[]
  tokens    AuthToken[]
  reports   Report[]
}

// Enlaces de un solo uso que se mandan por correo (confirmar correo, nueva contraseña).
// Solo se guarda la huella del código, nunca el código.
model AuthToken {
  id        String    @id @default(cuid())
  kind      String // "VERIFY_EMAIL" | "RESET_PASSWORD"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

// Anuncio de material (nuevo o de segunda mano), curso o servicio.
model Listing {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String // ver LISTING_CATEGORIES en src/lib/constants.ts
  condition   String // "NEW" | "USED"
  priceCents  Int? // vacío si es gratis
  isFree      Boolean  @default(false)
  location    String // zona o ciudad
  status      String   @default("ACTIVE") // "ACTIVE" | "RESERVED" | "SOLD"
  hiddenAt    DateTime? // oculto por moderación
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Texto en minúsculas y sin tildes para buscar igual en SQLite y en PostgreSQL
  // (lo rellena src/lib/search.ts al guardar).
  searchText     String @default("")
  locationSearch String @default("")

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  photos    ListingPhoto[]
  interests ListingInterest[]
  reports   Report[]

  @@index([sellerId])
  @@index([status, createdAt])
  @@index([category])
}

// Foto de un anuncio. "key" es la clave en el almacenamiento (ver src/lib/storage.ts).
model ListingPhoto {
  id       String @id @default(cuid())
  key      String
  position Int    @default(0) // la de menor número es la portada

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

// «Me interesa»: un socio avisa al anunciante (y ambos ven los datos de contacto del otro).
model ListingInterest {
  id        String   @id @default(cuid())
  message   String?
  createdAt DateTime @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([userId])
}

// Denuncia de un anuncio (la revisa un administrador en /admin).
model Report {
  id         String    @id @default(cuid())
  reason     String // ver REPORT_REASONS en src/lib/constants.ts
  details    String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  listingId  String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolvedAt])
}

// Registro de intentos para frenar abusos (registros masivos, spam...). Ver src/lib/rate-limit.ts.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
